# Copy this file to .env and fill in your key(s). Never commit .env.

# Which model to use: claude, gemini or ollama
LLM_PROVIDER=claude

# Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ollama runs models on your own computer, so it needs no key.
# Install it from https://ollama.com, then: ollama pull qwen3

# Optional: override the default model names
# CLAUDE_MODEL=claude-opus-5-5
# GEMINI_MODEL=gemini-2.5-flash
# OLLAMA_MODEL=qwen3

# Optional: where Ollama runs, if not on this computer (default http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# Optional: where each run's full transcript is saved (default logs/)
# TRANSCRIPTS_DIR=logs
